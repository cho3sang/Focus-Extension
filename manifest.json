{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "1.0",
  "description": "Blocks distracting websites to help you focus.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.tiktok.com/*",
    "*://*.youtube.com/*",
    "https://www.youtube.com/*",
    "*://*.primevideo.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "images/focus-16.png",
    "48": "images/focus-48.png",
    "128": "images/focus-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
